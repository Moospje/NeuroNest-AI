# Application settings
PROJECT_NAME=NeuroNest-AI
PROJECT_DESCRIPTION=AI Agent Orchestration Platform
PROJECT_VERSION=0.1.0
DEBUG=True

# API settings
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Database settings
SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/neuronest

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# OpenAI settings
OPENAI_API_KEY=your-openai-api-key